{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BoundaryAllowLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:387276719593:log-group:/aws/lambda/courselens-*"
    },
    {
      "Sid": "BoundaryAllowBedrockNovaInvokeOnly",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-*"
    }
  ]
}
