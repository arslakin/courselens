{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "moduleResolution": "Bundler",
    "composite": false,
    "noEmit": true,
    "allowJs": true,
    "lib": ["ES2020", "DOM"],
    "types": ["react", "node"],
    "paths": {
      "@rojanda/types": ["../../packages/types/src/index.ts"],
      "@rojanda/api": ["../../packages/api/src/index.ts"],
      "@rojanda/core": ["../../packages/core/src/index.ts"],
      "@rojanda/i18n": ["../../packages/i18n/src/index.ts"],
      "@rojanda/design": ["../../packages/design/src/index.ts"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
