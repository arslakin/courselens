{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BoundaryAllowLogsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-central-1:387276719593:log-group:/aws/lambda/rojanda-*"
    },
    {
      "Sid": "BoundaryAllowTranscribeBatchJobsOnly",
      "Effect": "Allow",
      "Action": [
        "transcribe:StartTranscriptionJob",
        "transcribe:GetTranscriptionJob"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BoundaryAllowMediaBucketObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::rojanda-media-387276719593/*"
    },
    {
      "Sid": "BoundaryAllowAppTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-central-1:387276719593:table/rojanda-app"
    }
  ]
}
